rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email']) &&
               data.keys().size() <= 6 &&
               data.uid == request.auth.uid &&
               data.email is string && data.email.size() <= 200;
      }
      
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isEmailVerified() && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isEmailVerified() && isValidUser(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // Saved Queries Rules
    match /saved_queries/{queryId} {
      function isValidQuery(data) {
        return data.keys().hasAll(['userId', 'name', 'query']) &&
               data.keys().size() <= 6 &&
               data.userId == request.auth.uid &&
               data.name is string && data.name.size() <= 100 &&
               data.query is string && data.query.size() <= 10000;
      }
      
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(queryId);
      allow create: if isSignedIn() && isEmailVerified() && isValidQuery(request.resource.data);
      allow update: if isSignedIn() && isEmailVerified() && resource.data.userId == request.auth.uid && isValidId(queryId) && 
                      isValidQuery(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'query']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(queryId);
    }
  }
}
